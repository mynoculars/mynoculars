# ---- LLM ------------------------------------------------------------------
# stub = deterministic offline mode (no model needed); live = real providers
LLM_MODE=stub

# Primary: Qwen Cogito on a local llama-server (OpenAI-compatible /v1)
LLM_PRIMARY_BASE_URL=http://127.0.0.1:8080/v1
LLM_PRIMARY_API_KEY=not-needed-for-local
LLM_PRIMARY_MODEL=qwen-cogito


# Fallback CHAIN, tried in order when the provider before it errors OR returns
# below-threshold quality:   primary (local) -> Mistral -> Gemini.
# A fallback joins the chain ONLY if its API key is set. Leave a key blank to
# skip that provider (e.g. no Gemini key -> chain is just primary -> Mistral).

# Fallback #1: Mistral (OpenAI-compatible endpoint)
LLM_MISTRAL_BASE_URL=https://api.mistral.ai/v1
LLM_MISTRAL_API_KEY=your-mistral-key
LLM_MISTRAL_MODEL=mistral-small-latest

# Fallback #2: Gemini Flash (Google OpenAI-compatibility endpoint)
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=your-gemini-api-key-here
# ---- The cloud fallback slot (D-114) --------------------------------------
# The THIRD position in the chain is "the cloud fallback", not "Gemini".
# LLM_FALLBACK_NAME is used verbatim as the provider name everywhere: every
# llm.* log line, llm.chain_built, D-110's llm.http_error, the judge field
# of quality.score_failed, D-111's health-check row, and pricing.py's rate
# lookup. Switching providers is therefore FOUR settings and no code -- and
# because the name travels with them, nothing downstream ends up claiming
# "gemini" while calling something else.
#
# A name with no pricing row reports no cost and says so at startup
# (config.fallback_provider_unpriced). "gemini" and "grok" both have rows.
#
# Model names get RETIRED, and a retired name fails as a plain 404 that
# looks exactly like a bad key. Verify whichever block you enable with:
#     python scripts/check_services.py
# which probes every configured provider with a real one-token completion
# and prints the status code and the provider's own error body on failure.

# --- Option A: Google Gemini (the default) ---
LLM_FALLBACK_NAME=gemini
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODEL=gemini-2.0-flash

# --- Option B: xAI Grok -- comment out Option A above, uncomment this ---
# Same OpenAI-compatible shape (bearer auth, /chat/completions), so no
# client change is needed; only these four settings move.
# LLM_FALLBACK_NAME=grok
# LLM_FALLBACK_BASE_URL=https://api.x.ai/v1
# LLM_FALLBACK_API_KEY=your-xai-api-key-here
# LLM_FALLBACK_MODEL=<check scripts/check_services.py for a name this key can use>

# Fall back when the primary's self-evaluated quality is below this (0..1)
LLM_QUALITY_THRESHOLD=0.6
# Two SEPARATE timeouts: the local primary (which can spend its first
# request just loading the model into memory, and needs real time on large
# prompts like the compiler's) gets its own, longer budget; Mistral/Gemini
# get a short one since a slow cloud response usually means something's
# actually wrong. See config.py for the full rationale.
LLM_PRIMARY_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=90

# Per-request generation cap sent to EVERY provider (D-54, guardrail G6).
# A runaway generation is a property of the model continuing past its own
# end-of-turn, not of network latency, so unlike the two timeouts above
# there is no reason to split this per provider.
#
# Raising it does not always raise the ceiling you actually hit (D-102):
# a provider can stop short of this number for its own reasons -- its own
# output cap, a gateway limit, or reasoning tokens spending a budget that
# `completion_tokens` never reports. `llm.truncated_by_token_limit` now
# says which ceiling was reached, `cap_source: ours` or `provider`. Only
# `ours` means this setting is the thing to change.
LLM_MAX_TOKENS=4096
# D-131: the other half of LLM_MAX_TOKENS -- that one bounds what a
# provider may GENERATE, this bounds how much EVIDENCE we may send in one
# compile or critique prompt. Until it existed nothing did: compile_report
# inlined every item, and critique kept a bare last-60 tail slice.
#
# Measured on run p205.267-check (4 goals, 97 items): 30,199 of the
# transcript's 32,873 characters were the evidence block. 12,000
# characters is ~3,000 estimated tokens, which lands a compile prompt at
# roughly the shape of p205.246's compile that actually succeeded (4,023
# prompt tokens). Re-derive it for your own corpus and provider -- a 32k
# cloud model and a `-c 1536` local one do not want the same number.
#
# Selection is round-robin across goals, best-first within each goal, so
# a goal with one hit is never crowded out by a goal with forty. 0
# disables the budget and restores the pre-D-131 prompt; startup WARNs
# (config.prompt_budget_unbounded) when it does.
PROMPT_EVIDENCE_MAX_CHARS=12000
# D-93: the local primary's context window -- the `-c` value you started
# llama-server with. 0 (the default) means "not configured", and leaves
# every routing decision byte-identical to before this existed.
#
# Set it and the router SKIPS the primary for any prompt that clearly
# cannot fit, instead of spending a guaranteed-failed call to find out.
# Live (p205.246-check): the primary served 216- and 444-token prompts
# and rejected 4,023- and 7,198-token ones in 95ms and 29ms -- an
# immediate refusal, not a timeout -- so every run burned two doomed
# calls and the logs read as provider flakiness. OPERATIONS.md's own
# recommended invocation for an 8 GB card is `-c 1536`, so:
#
#   LLM_PRIMARY_CONTEXT_TOKENS=1536
#
# Estimation is approximate (~4 chars/token) and the router only skips
# past 1.1x this value, so a near-boundary prompt is still attempted.
# The last provider in the chain is never skipped -- there would be
# nowhere to fall through to.
LLM_PRIMARY_CONTEXT_TOKENS=0

# ---- Storage (all optional — agent degrades gracefully if unreachable) ----
# Portable defaults: the sample corpus runs against a plain local stack out of
# the box (Docker compose or native, no auth). Point these at your own services
# by editing the URLs.
POSTGRES_DSN=postgresql://agent:agent@localhost:5432/agent
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
MEMORY_COLLECTION=agent_semantic_memory
CORPUS_INDEX=agent_corpus

# ---- OpenSearch security (OFF by default; the sample stack needs no auth) ---
# Set these only when connecting to a secured cluster (security plugin enabled,
# SSL + basic auth). Blank username keeps the default anonymous plain-HTTP path.
# Real credentials belong in your local .env (gitignored), never in this file.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# ---- Graph bounds (see README Design Decisions) ---------------------------
MAX_FANOUT=6
MAX_DEPTH=3
RECALL_TARGET=0.85
# P2-01: 0.5 is the MEASURED default, not the original inert 0.0 — a real
# debug trace showed off-topic corpus hits landing at 0.48-0.50 after
# RRF_SQUASH scaling (tools/corpus_search.py), which is why the coverage
# check in progress_checker_node uses strict `>` rather than `>=` against
# this exact value. Tune against your own corpus; don't assume 0.5 transfers.
MIN_EVIDENCE_SCORE=0.5
# P2-01's other half: a floor on the DENSE leg's raw cosine similarity,
# applied at RETRIEVAL time (retrieval/hybrid.py) before a hit ever becomes
# Evidence — without this, an out-of-domain query still returns k confident
# wrong answers. 0.35 is BELOW the measured noise floor for the shipped
# sample corpus (unrelated text scores 0.40-0.53 with this embedding model
# — see README's Calibration Numbers, You Can Verify and OPERATIONS.md's
# Step 3, "Calibrate the retrieval floor") and cannot filter anything
# against it; 0.60 is what that measurement derives for THIS corpus (S-9).
# Re-derive for your own corpus rather than copying either number —
# OPERATIONS.md Step 3 is the exact procedure.
MIN_SIMILARITY=0.60
# Guardrail G1 (S-9): observational only -- does not change routing or
# filtering. Fraction of dense-leg candidates MIN_SIMILARITY drops, per run,
# above which telemetry_node logs a WARNING (retrieval.floor_starvation),
# so a miscalibrated floor shows up in logs instead of only in a quietly
# low corpus_recall. 0.8 is the code default (config.py).
RETRIEVAL_FLOOR_WARN_RATIO=0.8
# D-47/G2 (S-9): the topical grounded-coverage target has_grounded_evidence
# (guardrails/retrieval.py) is checked against -- separate from
# RECALL_TARGET above, which only requires ANY evidence per goal, not
# evidence that is both a real document AND on-topic for it. 0.5 is the
# code default (config.py).
GROUNDED_RECALL_TARGET=0.5
MAX_REVISIONS=2
# Human-in-the-loop escalation (D-23): pauses the run for review on
# E1 (zero goals), E2/E3 (cannot converge), E4 (critique exhausted).
# Off by default; CLI prompts on stdin, API returns status=interrupted.
HITL_ENABLED=false
RECURSION_LIMIT=60
# D-132: the two bounds this graph did not have. MAX_DEPTH,
# MAX_REVISIONS, MAX_ESCALATIONS and RECURSION_LIMIT above bound a run in
# STEPS; nothing bounded it in TIME or in SPEND. Run p205.267-check sat
# inside all four and still took 237 seconds.
#
# Both 0 = OFF, and both ship off: this is the first setting here that
# can end a run early, so it is opt-in like HITL_ENABLED and MCP_ENABLED.
# With both at 0 the graph behaves exactly as it did before D-132.
#
# Spending a budget is a SOFT STOP: the run routes to the compiler
# instead of another gather lap or revision, the report carries a
# deterministic "stopped early" notice, and telemetry records
# run_budget_exhausted. Nothing is cancelled mid-node and a report is
# always produced.
#
# RUN_DEADLINE_SECONDS counts RESEARCH time -- seconds spent paused for a
# human review are subtracted, so a slow reviewer never spends the run's
# budget. 600 is a reasonable starting point against a 237-second run.
RUN_DEADLINE_SECONDS=0
# Prompt + completion tokens across every provider call -- the same total
# telemetry reports as llm_total_tokens. The enforcing complement to
# RUN_CALL_BUDGET_WARN, which counts requests and only warns.
RUN_TOKEN_BUDGET=0
# P2-12: LLM-based contradiction detection in the evidence merger. Off by
# default — costs one extra LLM call per gather cycle (up to MAX_DEPTH
# times per run) whenever any goal has 2+ evidence items. Turning this on
# is what makes the E2 escalation trigger reachable in a real run.
CONTRADICTION_DETECTION_ENABLED=false

# ---- Memory decay half-lives (days) ---------------------------------------
MEMORY_TOP_K=5
DECAY_HALF_LIFE_DAYS_SEMI_STABLE=90
DECAY_HALF_LIFE_DAYS_VOLATILE=14
# P2-10: server-side (Qdrant FormulaQuery) decay reranking instead of the
# Python over-fetch-then-rerank path. Off by default. Requires points to
# carry the "created_at_iso" payload field (only points written AFTER this
# shipped will have it) -- wipe and re-ingest (scripts/reset_stores.py) if
# you flip this on against a collection with pre-P2-10 points.
MEMORY_SERVER_SIDE_DECAY=false

# D-38 (S-9): the retrieval escalation ladder's terminal tier -- the
# model's OWN parametric knowledge, tried only after corpus/MCP/web are
# exhausted. On by default (true is the code default, config.py) so the
# ladder has somewhere to fall through to rather than returning nothing;
# evidence from this tier is tagged source="model" and is deliberately
# excluded from grounded_score/corpus_recall (D-42) and never written to
# long-term memory (see memory_write_min_score's docstring in config.py).
MODEL_KNOWLEDGE_ENABLED=true

# P2-13/P2-14: MCP tool seam (D-26/D-25, D-76). Off by default --
# corpus_search.py is ALWAYS the default worker regardless of this flag.
# Turning it on ADDITIONALLY wires the MCP tool in as a second,
# addressable specialist (P2-14) -- reachable only when a task's
# tool_hint == "mcp" (task_expander_node/gap_generator_node only tell the
# LLM that hint exists when this is on).
# D-76: this process NEVER spawns an MCP server. MCP_SERVER_URL points at
# an already-running, standalone server you start and stop yourself --
# see OPERATIONS.md's "Running the MCP servers standalone" for the full
# workflow. SSE is prohibited by D-30 outright and never used anywhere in
# this build.
MCP_ENABLED=false
# e.g. http://127.0.0.1:8765/mcp
MCP_SERVER_URL=
MCP_TOOL_NAME=search
MCP_QUERY_ARG_NAME=query
# 30s is fine against tests/fixtures/mcp_echo_http_server.py (instant, no
# real backend). A real run against scripts/mcp_corpus_server.py showed
# 30s can be too tight for that server's FIRST call, which lazily builds a
# real QdrantStore/OpenSearchStore/HybridRetriever inside the server
# process (fastembed model load + real network round trips) -- raise this
# well above 30 (e.g. 120) when pointing at a real corpus-backed MCP
# server.
MCP_CALL_TIMEOUT_SECONDS=30

# Size of the bridge's own thread pool for concurrent tool calls. The
# search_worker fan-out is bounded by MAX_FANOUT, so this only needs to
# keep up with that -- raising it past MAX_FANOUT buys nothing.
MCP_MAX_WORKERS=6

# ---- HTTP API auth (D-133) ------------------------------------------------
# The shared secret POST /research, POST /resume and GET
# /state/{thread_id} require. EMPTY = no authentication, which is how
# this project has always shipped and remains fine for a local reference
# run; the API logs `api.unauthenticated` at WARNING on startup so the
# state is visible rather than assumed.
#
# Send it as either header:
#     X-API-Key: <key>
#     Authorization: Bearer <key>
#
# GET /health stays open either way -- a liveness probe that needs
# credentials is a liveness probe that fails for the wrong reason. With a
# key SET, /health withholds its build-error detail from unauthenticated
# callers (the detail can name a misconfigured URL); with no key set it
# reports exactly as before.
#
# ONE key, no rotation, no per-caller identity, no scopes, no rate
# limiting. Deployment hygiene, not an authorization model -- anything
# needing per-tenant isolation still belongs behind a gateway.
API_KEY=

# ---- HTTP API async mode (D-134) ------------------------------------------
# 0 = OFF (the default). POST /research runs the graph inline and returns
# the finished report, exactly as it always has.
#
# Set it to a small number to accept {"wait": false} on POST /research:
# the call returns 202 with a thread_id and a status_url immediately, the
# run proceeds on a background thread, and the caller polls
# GET /result/{thread_id} until status is "done" (or "interrupted", or
# "failed"). One setting is both the switch and the pool size, so async
# mode cannot be enabled unbounded.
#
# A research run holds its thread for minutes -- p205.267-check took 237
# seconds -- and the pool QUEUES rather than rejecting, so pick this for
# how many concurrent runs your providers and stores can actually serve.
# Pair it with RUN_DEADLINE_SECONDS (D-132): shutdown waits for in-flight
# runs, and a deadline is what bounds that wait.
#
# ⚠ THE QUEUE IS IN-PROCESS. With `uvicorn --workers N` a poll can land
# on a worker that never saw the job; with a degraded (MemorySaver)
# checkpointer nothing survives a restart. Both are the SAME constraint
# /resume already has. A durable Postgres checkpointer plus a single
# worker is the configuration this is built for.
API_ASYNC_WORKERS=0

# ---- Phase 4: web search (D-57) -------------------------------------------
# The retrieval ladder (D-38) is corpus -> reformulated corpus -> mcp ->
# model recollection. Every one of the first three resolves to the SAME
# ingested documents, so "the corpus does not contain it" had nowhere left
# to escalate except the model's own memory. Web search is a real tier
# between those two.
#
# THE SETTINGS BELOW ARE READ BY THE SEARCH SERVER SUBPROCESS
# (scripts/mcp_web_search_server.py), which reads its own .env at startup --
# the same way scripts/mcp_corpus_server.py does. The agent never imports
# ddgs and never issues a search request of its own; it talks to the server
# over stdio through tools/mcp_client.py. The WEB_MCP_* settings that wire
# the AGENT side ship with that wiring.

# ddgs is the only provider implemented. No API key, no account, works from
# a plain checkout -- and it is an UNOFFICIAL client against an endpoint
# that promises it nothing, so treat throttling as expected rather than
# exceptional. Swapping in a keyed API is a new module in
# research_agent/websearch/ plus this one value.
WEB_SEARCH_PROVIDER=ddgs
# Modest on purpose: aggressive querying is what triggers throttling, and
# this also bounds how much untrusted third-party text enters one compile
# prompt. Hard ceiling of 25.
WEB_SEARCH_MAX_RESULTS=5
# The score band a result's RANK is mapped onto. Both ends are load-bearing:
#
#   FLOOR must EXCEED MIN_EVIDENCE_SCORE. The coverage gate (D-17) is a
#     strict `>`, so a floor at or below it means no web result can ever
#     mark a goal covered -- the tier runs, costs real time, and
#     contributes nothing. Startup WARNs (config.web_search_tier_inert)
#     when this is misconfigured; it does not refuse to start.
#   CEILING must stay well under the ~1.0 a document both retrieval legs
#     ranked first reaches. D-38's invariant is that a real document beats
#     weaker provenance; a snippet allowed to score 0.95 would outrank
#     fused corpus evidence in the compiler's context.
#
# The default band also sits ABOVE MODEL_KNOWLEDGE_SCORE (0.60), which is
# the intended order: a live retrieved snippet is better provenance than
# recollection, worse than a curated document.
WEB_SEARCH_MIN_SCORE=0.60
WEB_SEARCH_MAX_SCORE=0.75
# At most this many hits from any one domain. Not tidiness: five results
# from one site read to the compiler as five independent sources agreeing,
# and telemetry's result count looks identical either way. 0 disables the
# cap, the documented way to reproduce uncapped behaviour deliberately.
WEB_SEARCH_MAX_PER_DOMAIN=2
# Engine request shaping. "wt-wt" is DDGS's own no-region default; a
# country code ("in-en", "de-de") biases results accordingly.
WEB_SEARCH_REGION=wt-wt
WEB_SEARCH_SAFESEARCH=moderate
# Per-HTTP-request timeout INSIDE the provider. Distinct from the MCP call
# timeout on the agent side -- this one stops a single hung request from
# holding a server thread forever, that one stops the agent waiting on a
# wedged subprocess. Both are needed.
WEB_SEARCH_PROVIDER_TIMEOUT_SECONDS=20
# The search server's own thread pool, mirroring MCP_MAX_WORKERS for the
# corpus server. Separate value on purpose: these pools front totally
# different work (outbound internet vs. local Qdrant/OpenSearch).
WEB_SEARCH_MAX_WORKERS=6

# --- the AGENT side of web search -------------------------------------------
# Everything above is read by the search server subprocess. Everything below
# is read by assembly.py to wire the SECOND MCPBridge.
#
# A separate namespace from MCP_*, not a reuse: in every deployment of this
# repo so far MCP_* points at scripts/mcp_corpus_server.py, i.e. the corpus
# reached a second way. Two namespaces let both servers run at once, which
# is the point -- the ladder is corpus -> reformulated -> mcp -> web -> model.
#
# Off by default: no surprise egress, no surprise third-party text in a
# prompt. With this false the ladder is byte-identical to every pre-Phase-4
# run.
WEB_SEARCH_ENABLED=false
# D-76: this process NEVER spawns the web-search server. WEB_MCP_SERVER_URL
# points at an already-running, standalone server you start and stop
# yourself -- see OPERATIONS.md's "Running the MCP servers standalone" for
# the full workflow.
# e.g. http://127.0.0.1:8766/mcp
WEB_MCP_SERVER_URL=
WEB_MCP_TOOL_NAME=web_search
WEB_MCP_QUERY_ARG_NAME=query
# Higher than MCP_CALL_TIMEOUT_SECONDS: a corpus lookup is a local round
# trip, a web search is a third-party HTTP request that may be retried or
# throttled upstream. Still bounded -- the ladder must be able to give up on
# this tier and reach the model tier within a sensible wall-clock budget.
WEB_MCP_CALL_TIMEOUT_SECONDS=45

# Debug tracing: dump exact prompts, raw responses, provider/tokens/latency
# per LLM call, and every retrieval engine's hits, to logs/trace-<run_id>.txt.
# Also toggled per-run with the CLI flag:  --debug  (flag wins over this).
DEBUG_TRACE=false

LOG_LEVEL=INFO

# Phase 3: Langfuse observability. Off by default -- when off, no SDK
# import, no client construction, zero network calls (see
# research_agent/langfuse/client.py). LANGFUSE_HOST is a plain
# configurable URL, never hardcoded to cloud.langfuse.com -- the same
# code works against Langfuse Cloud, a self-hosted instance, or an
# enterprise install by changing this one value.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=
# What leaves this process for Langfuse. Redaction runs before any
# payload is sent -- see research_agent/langfuse/masking.py.
#   patterns  (default) redact emails, bearer tokens, sk-/pk- API keys
#             and card-like digit runs; keep all other text and the
#             full payload structure
#   all       replace every string leaf with [REDACTED]; numbers and
#             structure survive, no free text does
#   off       send prompts, model outputs and retrieved evidence
#             verbatim (logs a warning at startup)
# "patterns" is defence in depth, not a compliance guarantee: free-text
# PII matching none of the four shapes still leaves the process. Use
# "all" where that is not acceptable.
LANGFUSE_MASK_MODE=patterns
# Per-provider $ cost per 1,000,000 tokens, input/output. Never
# hardcoded in code -- see research_agent/langfuse/pricing.py. Local
# primary defaults to 0/0 (a genuinely free local model); cloud
# providers default to 0/0 too until you configure your actual rate --
# an unconfigured cloud provider reports $0 cost rather than a silently
# wrong guessed number.
LANGFUSE_PRICE_PRIMARY_IN_PER_1M=0.0
LANGFUSE_PRICE_PRIMARY_OUT_PER_1M=0.0
LANGFUSE_PRICE_MISTRAL_IN_PER_1M=0.0
LANGFUSE_PRICE_MISTRAL_OUT_PER_1M=0.0
LANGFUSE_PRICE_GEMINI_IN_PER_1M=0.0
LANGFUSE_PRICE_GEMINI_OUT_PER_1M=0.0
# D-114: used when LLM_FALLBACK_NAME=grok. Left at 0.0 for the same
# reason as every rate here -- an unconfigured provider reporting $0
# beats a silently guessed number.
LANGFUSE_PRICE_GROK_IN_PER_1M=0.0
LANGFUSE_PRICE_GROK_OUT_PER_1M=0.0
# What to report when the rates above work out to exactly $0.
#   explicit  (default) send "$0". Correct for a genuinely free local
#             model. Also OVERRIDES Langfuse's own model pricing table
#             for a cloud provider whose rate was simply never set.
#   infer     omit the cost and let Langfuse price it from the model
#             name instead. Trade-off: an unrecognized model string
#             (a local .gguf filename) then shows NO cost, not $0.
# Code cannot distinguish "free" from "unconfigured" -- both compute to
# 0.0 -- so the choice is declared here.
LANGFUSE_COST_MODE=explicit
